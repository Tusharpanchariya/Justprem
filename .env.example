# Resend (set these in your hosting provider's Production environment, then redeploy)
# The From address must use a domain verified in Resend.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=orders@justprem.shop
RESEND_ADMIN_EMAIL=connect@justprem.shop

# Checkout policy acceptance records (server-side only; never expose service role to the browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Protects /admin/policy-acceptances; set a long random secret
CHECKOUT_ADMIN_TOKEN=replace_with_a_long_random_secret
